{
  "name": "aurora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --watch-path=server --watch-path=src server/index.mjs\"",
    "dev:client": "vite",
    "dev:server": "node --watch-path=server --watch-path=src server/index.mjs",
    "build": "vite build",
    "typecheck": "tsc -b",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "node --test server/recommendations.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "groq-sdk": "^1.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.1.13",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
